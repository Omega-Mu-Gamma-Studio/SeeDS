+/* ============================================================
+   SeeDS 2.0 — Design Tokens
+   Generated to match GAMMA_COUSINS.md §2 palette rows.
+   Two orthogonal layers (Master UI/UX Doc §1):
+     1. Time-of-day  -> base neutrals   (:root / [data-theme='night'])
+     2. Advisor      -> accent colors   ([data-cousin='...'])
+   Structure-diagram tokens (--ds-*) are a THIRD, fully separate
+   namespace. Never let a component read --accent-* to color a
+   Konva canvas element, and never let a renderer read --ds-*
+   for chrome.
+   ============================================================ */
+
+:root {
+  /* ---- Day (base neutrals) ---- */
+  --bg-base: #F4EDE0;
+  --bg-elevated: #FFFFFF;
+  --bg-sunken: #E9E0CE;
+  --ink: #2B2620;
+  --ink-muted: #6B6357;
+  --border-subtle: rgba(43, 38, 32, 0.12);
+  --texture-overlay: none;
+  --ambient-glow: none;
+  --shadow-elevated: 0 4px 16px rgba(43, 38, 32, 0.10);
+
+  /* ---- Structure-diagram tokens (PRD §11.3 — cousin-agnostic, permanent) ---- */
+  --ds-node: #4A90D9;
+  --ds-node-ink: #FFFFFF;
+  --ds-pointer: #F5A623;
+  --ds-null: #999999;
+  --ds-broken: #E74C3C;
+  --ds-highlight: #FFD700;
+  --ds-circular-intentional: #3CA05A;
+
+  /* ---- Typography ---- */
+  --font-code: 'Fira Code', 'JetBrains Mono', ui-monospace, monospace;
+  --font-body: 'Inter', system-ui, -apple-system, sans-serif;
+
+  /* ---- Motion (PRD §11.3.4) ---- */
+  --t-phase: 0.3s;
+  --t-highlight: 0.2s;
+  --t-bug: 0.5s;
+  --t-insert: 0.5s;
+  --t-rotation: 0.5s;
+
+  /* ---- Radii / spacing scale ---- */
+  --radius-sm: 6px;
+  --radius-md: 12px;

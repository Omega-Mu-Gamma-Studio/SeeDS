diff --git a/src/components/cousin/CousinAvatar.css b/src/components/cousin/CousinAvatar.css
index 58b2996..ec8951e 100644
--- a/src/components/cousin/CousinAvatar.css
+++ b/src/components/cousin/CousinAvatar.css
@@ -42,3 +42,101 @@
 }
 
 .cousin-avatar--sm .cousin-avatar__glyph { font-size: 0.7rem; }
+
+/* ============================================================
+   Portrait mode -- full ink-wash illustrations, not sprites.
+   Rounded-rect, not circle: these images carry real scene
+   composition (props, setting, mood) that a circular crop would
+   cut off or crush. Taller than wide, so the frame respects the
+   source illustration's portrait-oriented staging instead of
+   fighting it down into a square or circle.
+   ============================================================ */
+
+.cousin-avatar--portrait {
+  display: inline-block;
+}
+
+.cousin-avatar__frame {
+  position: relative;
+  overflow: hidden;
+  border-radius: var(--radius-md);
+  border: 2px solid var(--bg-elevated);
+  box-shadow: var(--shadow-elevated);
+  background: var(--bg-sunken);
+}
+
+.cousin-avatar__portrait-img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.cousin-avatar__portrait-glyph {
+  position: absolute;
+  bottom: 0.3rem;
+  right: 0.3rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 1.6rem;
+  height: 1.6rem;
+  border-radius: 50%;
+  background: var(--bg-elevated);
+  box-shadow: var(--shadow-elevated);
+  font-size: 0.85rem;
+  line-height: 1;
+}
+
+/* sm: picker grid -- tight bust crop, face-forward, just enough to
+   differentiate ten cousins at a glance. object-position keeps the crop
+   anchored near the face rather than centering on the whole scene. */
+.cousin-avatar--sm .cousin-avatar__frame {
+  width: 64px;
+  height: 80px;
+}
+.cousin-avatar--sm .cousin-avatar__portrait-img {
+  object-position: 50% 22%;
+}
+.cousin-avatar--sm .cousin-avatar__portrait-glyph {
+  width: 1.15rem;
+  height: 1.15rem;
+  font-size: 0.6rem;
+  bottom: 0.15rem;
+  right: 0.15rem;
+}
+
+/* md: lesson sidebar -- head-to-chest, hints at desk/props below without
+   needing them fully legible at this size. */
+.cousin-avatar--md .cousin-avatar__frame {
+  width: 96px;
+  height: 128px;
+}
+.cousin-avatar--md .cousin-avatar__portrait-img {
+  object-position: 50% 18%;
+}
+
+/* lg: Home hero -- the full scene gets to breathe. This is where the
+   illustration's atmosphere (setting, props, mood) actually gets to do
+   its job instead of being cropped away. */
+.cousin-avatar--lg .cousin-avatar__frame {
+  width: 220px;
+  height: 300px;
+}
+.cousin-avatar--lg .cousin-avatar__portrait-img {
+  object-position: 50% 10%;
+}
+.cousin-avatar--lg .cousin-avatar__portrait-glyph {
+  width: 2.1rem;
+  height: 2.1rem;
+  font-size: 1.1rem;
+  bottom: 0.5rem;
+  right: 0.5rem;
+}
+
+@media (max-width: 640px) {
+  .cousin-avatar--lg .cousin-avatar__frame {
+    width: 160px;
+    height: 220px;
+  }
+}
